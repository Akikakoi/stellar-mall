# =========================================================
# stellar-mall 本地开发环境变量示例
# 用法：cp .env.example .env  然后按需要修改
# 说明：.env 已被 .gitignore 忽略，不会提交；本文件是模板，可以提交。
# =========================================================

# ---------- Docker Compose 基础设施（仅本地开发，禁止用于生产）----------
# docker-compose.yml 中这几项都有默认值，不配 .env 也能直接 docker compose up -d
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=stellar
MYSQL_PASSWORD=123456

# ---------- 后端（application-dev.yml 被忽略，需你自己创建）----------
# 复制 stellar-server/src/main/resources/application-dev.yml.example
# 为 application-dev.yml 后填写，不要在这里写。

# ---------- RAG 后端（rag-backend/.env 被忽略）----------
# 复制 rag-backend/.env.example 为 rag-backend/.env 后填写，不要在这里写。
