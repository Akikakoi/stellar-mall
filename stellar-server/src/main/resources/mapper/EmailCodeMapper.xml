<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stellar.mapper.EmailCodeMapper">

    <resultMap id="EmailCodeMap" type="com.stellar.entity.EmailCode">
        <id property="id" column="id"/>
        <result property="email" column="email"/>
        <result property="code" column="code"/>
        <result property="type" column="type"/>
        <result property="used" column="used"/>
        <result property="expireTime" column="expire_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO stellar_email_code (email, code, type, used, expire_time, create_time)
        VALUES (#{email}, #{code}, #{type}, #{used}, #{expireTime}, #{createTime})
    </insert>

    <select id="findLatest" resultMap="EmailCodeMap">
        SELECT * FROM stellar_email_code
        WHERE email = #{email} AND type = #{type} AND used = 0 AND expire_time > NOW()
        ORDER BY create_time DESC LIMIT 1
    </select>

    <update id="markUsed">
        UPDATE stellar_email_code SET used = 1 WHERE id = #{id}
    </update>

    <delete id="deleteExpired">
        DELETE FROM stellar_email_code WHERE expire_time &lt; #{before}
    </delete>
</mapper>