<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stellar.mapper.ServiceItemMapper">

    <resultMap id="ServiceItemMap" type="com.stellar.entity.ServiceItem">
        <id     property="id"          column="id"/>
        <result property="code"        column="code"/>
        <result property="title"       column="title"/>
        <result property="price"       column="price"/>
        <result property="description" column="description"/>
        <result property="status"      column="status"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateTime"  column="update_time"/>
    </resultMap>

    <!-- =========================== insert =========================== -->
    <insert id="insert" parameterType="com.stellar.entity.ServiceItem"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO stellar_service_item (
            code, title, price, description, status, create_time, update_time
        ) VALUES (
            #{code}, #{title}, #{price}, #{description}, #{status}, #{createTime}, #{updateTime}
        )
    </insert>

    <!-- =========================== update =========================== -->
    <update id="update" parameterType="com.stellar.entity.ServiceItem">
        UPDATE stellar_service_item
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="price != null">price = #{price},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM stellar_service_item WHERE id = #{id}
    </delete>

    <!-- =========================== get =========================== -->
    <select id="getById" resultMap="ServiceItemMap">
        SELECT * FROM stellar_service_item WHERE id = #{id}
    </select>

    <select id="getByCode" resultMap="ServiceItemMap">
        SELECT * FROM stellar_service_item WHERE code = #{code}
    </select>

    <select id="listAll" resultMap="ServiceItemMap">
        SELECT * FROM stellar_service_item ORDER BY id
    </select>

    <select id="listEnabled" resultMap="ServiceItemMap">
        SELECT * FROM stellar_service_item WHERE status = 1 ORDER BY id
    </select>

    <select id="listByIds" resultMap="ServiceItemMap">
        SELECT * FROM stellar_service_item WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY id
    </select>

</mapper>
