<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stellar.mapper.NotificationLogMapper">

    <resultMap id="NotificationLogMap" type="com.stellar.entity.NotificationLog">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="channel" column="channel"/>
        <result property="type" column="type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="errorMsg" column="error_msg"/>
        <result property="sendTime" column="send_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO stellar_notification_log (user_id, phone, email, channel, type, title, content, status, error_msg, send_time, create_time)
        VALUES (#{userId}, #{phone}, #{email}, #{channel}, #{type}, #{title}, #{content}, #{status}, #{errorMsg}, #{sendTime}, #{createTime})
    </insert>

    <select id="page" resultMap="NotificationLogMap">
        SELECT * FROM stellar_notification_log
        <where>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="type != null and type != ''">AND type = #{type}</if>
            <if test="channel != null and channel != ''">AND channel = #{channel}</if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM stellar_notification_log
        <where>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="type != null and type != ''">AND type = #{type}</if>
            <if test="channel != null and channel != ''">AND channel = #{channel}</if>
        </where>
    </select>
</mapper>
