<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- ============================================================
     SKU（商品规格单元）Mapper（stellar_sku）
     管理商品 SKU 的规格、多价格体系（售价/原价/成本/市场价）、
     库存与状态。库存扣减/回滚提供 乐观锁(version) 与 Redis 锁 两套方案。
     ============================================================ -->
<mapper namespace="com.stellar.mapper.SkuMapper">

    <!-- 数据库字段 → 实体属性映射 -->
    <resultMap id="SkuMap" type="com.stellar.entity.Sku">
        <id     property="id"           column="id"/>
        <result property="spuId"        column="spu_id"/>
        <result property="name"         column="name"/>
        <result property="specs"        column="specs"/>
        <result property="specsJson"    column="specs_json"/>
        <result property="price"        column="price"/>
        <result property="originalPrice" column="original_price"/>
        <result property="costPrice"    column="cost_price"/>
        <result property="stock"        column="stock"/>
        <result property="version"      column="version"/>
        <result property="warnStock"    column="warn_stock"/>
        <result property="weightG"      column="weight_g"/>
        <result property="barcode"      column="barcode"/>
        <result property="image"        column="image"/>
        <result property="sort"         column="sort"/>
        <result property="status"       column="status"/>
        <result property="createTime"   column="create_time"/>
        <result property="createUser"   column="create_user"/>
        <result property="updateTime"   column="update_time"/>
        <result property="updateUser"   column="update_user"/>
    </resultMap>

    <!-- =========================== insert =========================== -->
    <insert id="insert" parameterType="com.stellar.entity.Sku"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO stellar_sku (
            spu_id, name, specs, specs_json,
            price, original_price, cost_price,
            stock, version, warn_stock, weight_g, barcode, image, sort, status,
            create_time, create_user, update_time, update_user
        ) VALUES (
            #{spuId}, #{name}, #{specs}, #{specsJson},
            #{price}, #{originalPrice}, #{costPrice},
            #{stock}, #{version}, #{warnStock}, #{weightG}, #{barcode}, #{image}, #{sort}, #{status},
            #{createTime}, #{createUser}, #{updateTime}, #{updateUser}
        )
    </insert>

    <!-- =========================== update 动态 =========================== -->
    <update id="update" parameterType="com.stellar.entity.Sku">
        UPDATE stellar_sku
        <set>
            <if test="spuId != null">spu_id = #{spuId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="specs != null">specs = #{specs},</if>
            <if test="specsJson != null">specs_json = #{specsJson},</if>
            <if test="price != null">price = #{price},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="costPrice != null">cost_price = #{costPrice},</if>
            <!-- 管理端改库存必须推进 version：version 反映“库存被外部变更”的语义，
                 若只 SET stock 不推 version，会与原子扣减的 stock>=qty 兜底之外的
                 version 语义脱节（历史版本曾存在把库存扣成负数的组合路径） -->
            <if test="stock != null">stock = #{stock}, version = version + 1,</if>
            <if test="warnStock != null">warn_stock = #{warnStock},</if>
            <if test="weightG != null">weight_g = #{weightG},</if>
            <if test="barcode != null">barcode = #{barcode},</if>
            <if test="image != null">image = #{image},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            update_time = #{updateTime},
            update_user = #{updateUser}
        </set>
        WHERE id = #{id}
    </update>

    <!-- 乐观锁扣库存：stock - qty, version + 1；受影响行数 0 表示冲突/不足 -->
    <update id="deductStockWithVersion">
        UPDATE stellar_sku
        SET stock   = stock - #{qty},
            version = version + 1
        WHERE id = #{id}
          AND version = #{version}
          AND stock &gt;= #{qty}
    </update>

    <!-- 乐观锁回滚库存：stock + qty, version + 1 -->
    <update id="rollbackStockWithVersion">
        UPDATE stellar_sku
        SET stock   = stock + #{qty},
            version = version + 1
        WHERE id = #{id}
          AND version = #{version}
    </update>

    <!-- Redis 锁模式直接扣库存：只校验库存充足，不依赖 version -->
    <update id="deductStock">
        UPDATE stellar_sku
        SET stock = stock - #{qty}
        WHERE id = #{id}
          AND stock &gt;= #{qty}
    </update>

    <!-- 原子条件扣减（推荐方案）：单条 UPDATE 完成扣减 + version 递增 + 库存兜底。
         UPDATE 是当前读，RR/RC 下均正确，不再依赖“读-判-写+重试”循环
         （RR 下重试循环里 getById 快照读永远拿到旧 version，导致重试必然失败）。
         rows==0 即库存不足或 SKU 不存在。 -->
    <update id="deductStockAtomic">
        UPDATE stellar_sku
        SET stock   = stock - #{qty},
            version = version + 1
        WHERE id = #{id}
          AND stock &gt;= #{qty}
    </update>

    <!-- 原子回滚库存：无条件加回并递增 version，rows==0 表示 SKU 不存在 -->
    <update id="rollbackStockAtomic">
        UPDATE stellar_sku
        SET stock   = stock + #{qty},
            version = version + 1
        WHERE id = #{id}
    </update>

    <!-- Redis 锁模式直接回滚库存：不依赖 version -->
    <update id="rollbackStock">
        UPDATE stellar_sku
        SET stock = stock + #{qty}
        WHERE id = #{id}
    </update>

    <!-- =========================== delete/get/list =========================== -->
    <delete id="deleteById">
        DELETE FROM stellar_sku WHERE id = #{id}
    </delete>

    <!-- 删除商品下全部 SKU（删除 SPU 时级联清理） -->
    <delete id="deleteBySpuId">
        DELETE FROM stellar_sku WHERE spu_id = #{spuId}
    </delete>

    <select id="getById" resultMap="SkuMap">
        SELECT * FROM stellar_sku WHERE id = #{id} LIMIT 1
    </select>

    <!-- 按 id 集合批量查询 SKU（购物车/下单批量取价） -->
    <select id="listByIds" resultMap="SkuMap">
        SELECT * FROM stellar_sku
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 查询商品下全部 SKU（详情页规格选择用，按 sort 排序） -->
    <select id="listBySpuId" resultMap="SkuMap">
        SELECT * FROM stellar_sku
        WHERE spu_id = #{spuId}
        ORDER BY sort ASC, id ASC
    </select>

    <!-- ==================== 管理端库存管理 ==================== -->
    <select id="pageForInventory" resultMap="SkuMap">
        SELECT * FROM stellar_sku
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="lowStock != null and lowStock == 1">
                AND stock &lt;= warn_stock AND status = 1
            </if>
        </where>
        ORDER BY stock ASC, id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countForInventory" resultType="long">
        SELECT COUNT(*) FROM stellar_sku
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="lowStock != null and lowStock == 1">
                AND stock &lt;= warn_stock AND status = 1
            </if>
        </where>
    </select>

    <!-- 管理端调整库存：GREATEST 防负，推进 version，更新 update_time -->
    <update id="adjustStock">
        UPDATE stellar_sku
        SET stock = GREATEST(0, stock + #{delta}),
            version = version + 1,
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 管理端更新 SKU 元数据（预警库存），不触发 @AutoFill，手动维护 update 字段 -->
    <update id="updateStockMeta" parameterType="com.stellar.entity.Sku">
        UPDATE stellar_sku
        SET warn_stock = #{warnStock},
            update_time = NOW(),
            update_user = #{updateUser}
        WHERE id = #{id}
    </update>

</mapper>
