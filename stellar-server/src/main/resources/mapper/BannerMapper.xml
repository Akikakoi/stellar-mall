<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- ============================================================
     轮播图 Banner Mapper（stellar_banner）
     提供首页/活动 Banner 的增删改查、M 端分页管理与 C 端启用列表。
     status: 0 停用 / 1 启用。
     ============================================================ -->
<mapper namespace="com.stellar.mapper.BannerMapper">

    <!-- 数据库字段 → 实体属性映射 -->
    <resultMap id="BannerMap" type="com.stellar.entity.Banner">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="imageUrl" column="image_url"/>
        <result property="linkUrl" column="link_url"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="createUser" column="create_user"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateUser" column="update_user"/>
    </resultMap>

    <!-- 新增 Banner -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO stellar_banner (title, image_url, link_url, sort, status, create_time, create_user, update_time, update_user)
        VALUES (#{title}, #{imageUrl}, #{linkUrl}, #{sort}, #{status}, #{createTime}, #{createUser}, #{updateTime}, #{updateUser})
    </insert>

    <!-- 更新 Banner：仅更新传入的非空字段 -->
    <update id="update">
        UPDATE stellar_banner
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            update_time = #{updateTime}, update_user = #{updateUser}
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除 Banner -->
    <delete id="deleteById">
        DELETE FROM stellar_banner WHERE id = #{id}
    </delete>

    <!-- 按 id 查询 -->
    <select id="getById" resultMap="BannerMap">
        SELECT * FROM stellar_banner WHERE id = #{id}
    </select>

    <!-- M 端分页查询：支持按标题模糊、状态过滤，按 sort 倒序 -->
    <select id="page" resultMap="BannerMap">
        SELECT * FROM stellar_banner
        <where>
            <if test="title != null and title != ''">AND title LIKE CONCAT('%', #{title}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY sort DESC, id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- M 端分页总数统计（条件与 page 保持一致） -->
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM stellar_banner
        <where>
            <if test="title != null and title != ''">AND title LIKE CONCAT('%', #{title}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </select>

    <!-- C 端：查询所有启用中的 Banner（首页轮播），sort 越大越靠前 -->
    <select id="listEnabled" resultMap="BannerMap">
        SELECT * FROM stellar_banner WHERE status = 1 ORDER BY sort DESC, id ASC
    </select>
</mapper>
