{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.js", "vitest.config.js", "playwright.config.js", "e2e/**/*.js"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
