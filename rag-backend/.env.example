# ==================== 系统配置 ====================
APP_NAME=电商商品RAG智能问答系统
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# ⚠️ 请修改为一个随机强字符串（JWT 签名用），示例生成命令：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-me-to-a-random-strong-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# 管理员 / 演示用户初始密码（可选，不填则首次启动时随机生成并输出到控制台）
# 推荐：生产环境务必显式设置强密码，不要依赖随机值（控制台只输出一次）
#DEFAULT_ADMIN_PASSWORD=ChangeMe_To_StrongPassword_2026!
#DEFAULT_DEMO_PASSWORD=ChangeMe_To_StrongPassword_2026!

# ==================== 数据库 ====================
DATABASE_URL=sqlite:///./data/sqlite/app.db

# ==================== 通义千问 DashScope API ====================
# ⚠️ 请在阿里云百炼控制台 https://bailian.console.aliyun.com/ 获取 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL_NAME=qwen-plus
# 可选: qwen-turbo / qwen-plus / qwen-max
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ==================== Embedding 模型 ====================
# 优先本地BGE，若失败则走 DashScope text-embedding-v2
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# ==================== 向量数据库 ====================
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=ecommerce_knowledge_base

# ==================== 文件上传 ====================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=20971520
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.csv

# ==================== RAG 检索参数 ====================
RETRIEVER_TOP_K=20
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.4
CHUNK_SIZE=512
CHUNK_OVERLAP=64
QUERY_REWRITE_ENABLED=true

# ==================== 缓存 ====================
QUERY_CACHE_MAXSIZE=128
QUERY_CACHE_SIM_THRESHOLD=0.97
QUERY_CACHE_TTL_SECONDS=300

# ==================== 限流 ====================
RATE_LIMIT_PER_MINUTE_AUTH=60
RATE_LIMIT_PER_MINUTE_CHAT=15

# ==================== 数据目录 ====================
SAMPLE_DATA_DIR=./data/sample_data

# ==================== ★ 星耀商城 stellar-mall 跨端互通密钥（关键！两端必须完全一致） ★ ====================
# 1) 共享 JWT 密钥：用于 RAG 验证 Mall Java 签发的管理员 / C 端用户 JWT
#    - STELLAR_ADMIN_SECRET_KEY : 对应 Mall 配置 stellar.jwt.admin-secret-key
#    - STELLAR_USER_SECRET_KEY  : 对应 Mall 配置 stellar.jwt.user-secret-key
#    请替换成强随机值（与 Mall 端完全一致！）
#      生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
STELLAR_ADMIN_SECRET_KEY=please-change-to-32plus-random-string_MATCH_MALL_ADMIN
STELLAR_USER_SECRET_KEY=please-change-to-32plus-random-string_MATCH_MALL_USER

# 2) 内部同步密钥：Mall → RAG 知识库商品同步接口鉴权
#    - 对应 Mall 配置 stellar.rag.internal-sync-secret（必须完全一致）
STELLAR_RAG_INTERNAL_SYNC_SECRET=please-change-to-32plus-random-string_MATCH_RAG_SYNC

# 3) Mall 桥接（只读探活/健康检查，可选）
# MALL_BRIDGE_MYSQL_URL=mysql+pymysql://stellar_ro:123456@127.0.0.1:3306/stellar_mall?charset=utf8mb4
# MALL_BRIDGE_REDIS_URL=redis://127.0.0.1:6379/11
MALL_API_BASE_URL=http://127.0.0.1:8082

# Agent 工具调用 Mall Java 后端的超时/重试/熔断保护
MALL_API_TIMEOUT_SECONDS=10.0
MALL_API_MAX_RETRIES=2
MALL_API_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
MALL_API_CIRCUIT_BREAKER_RECOVERY_SECONDS=30
